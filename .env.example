# Application
APP_ENV=development
APP_NAME=PRISM
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Security
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=false
ENABLE_HTTP_BOOTSTRAP=false
BOOTSTRAP_TOKEN=

# Optional idempotent demo accounts. Never use production credentials here.
DEMO_MODE=false
DEMO_TEACHER_NAME=Demo Teacher
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_STUDENT_NAME=Demo Student
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism

# OpenAI: add the key when ready. Runtime AI is restricted to gpt-5.6-luna.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
LUNA_MODEL=gpt-5.6-luna
GPT4O_MODEL=gpt-4o
GPT4O_MINI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
AI_CONCURRENCY=3
AI_REVIEW_THRESHOLD=0.75

# Private S3-compatible object storage
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=prism-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=300

# Upload processing
MAX_UPLOAD_MB=20
MAX_SUBMISSION_PAGES=10
MAX_IMAGE_DIMENSION=2400
PROCESSED_IMAGE_QUALITY=88

# Durable processing worker
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
JOB_STALE_AFTER_SECONDS=600
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Google Drive Picker. Configure this after creating an OAuth web client and
# registering the production callback/origin in Google Cloud.
GOOGLE_DRIVE_CLIENT_ID=

# Frontend build-time API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
